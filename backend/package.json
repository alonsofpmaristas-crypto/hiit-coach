{
  "name": "hiit-coach-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "build": "prisma generate",
    "test": "node --test test/unit/*.test.js",
    "test:integration": "dotenv -e .env.test -- npx prisma db push --skip-generate && dotenv -e .env.test -- node --test test/integration/*.test.js",
    "test:all": "npm test && npm run test:integration",
    "db:seed": "node prisma/seed.js"
  },
  "prisma": { "seed": "node prisma/seed.js" },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "socket.io": "^4.7.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "dotenv-cli": "^7.4.2",
    "prisma": "^5.22.0",
    "supertest": "^7.0.0"
  }
}
